#!/usr/bin/env bash
# Real storage pipeline test on two loop devices — FOR A THROWAWAY VM.
# It exercises root partition/LUKS/Btrfs plus the optional encrypted VM disk,
# then verifies the exact stage-2 storage contract consumed by Ansible.
#
# usage: sudo VM_TEST=1 bash tests/vm-pipeline-test
set -uo pipefail

pass() { echo "[PASS] $*"; }
fail() { echo "[FAIL] $*"; exit 1; }
skip() { echo "[SKIP] $*"; exit 0; }

[[ ${VM_TEST:-0} == 1 ]] || skip "set VM_TEST=1 to acknowledge this runs REAL commands (VM only)"
(( EUID == 0 )) || skip "needs root"
for tool in losetup sgdisk cryptsetup mkfs.fat mkfs.btrfs btrfs findmnt lsattr stat lsblk readlink udevadm; do
	command -v "$tool" > /dev/null || skip "$tool not available"
done
if [[ ! -e /dev/mapper/control ]]; then
	modprobe dm_crypt 2>/dev/null || true
fi
[[ -e /dev/mapper/control ]] || skip "device-mapper not available (container?)"
[[ -S /run/udev/control ]] || skip "udevd not running — by-partlabel symlinks will not appear"
command -v partprobe > /dev/null || skip "partprobe not available"

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
export DRY_RUN=0
# shellcheck source=bootstrap
source "$HERE/bootstrap"

mapper_fixture_loop() {
	local mapper_name="$1"
	local expected_prefix="$2"
	local mapper_path="/dev/mapper/$mapper_name"
	local dm_node slave parent loop backing

	[[ -e $mapper_path ]] || return 1
	dm_node=$(basename "$(readlink -f "$mapper_path")") || return 1
	slave=$(find "/sys/class/block/$dm_node/slaves" -mindepth 1 -maxdepth 1 -printf '%f\n' 2>/dev/null | head -n1)
	[[ -n $slave ]] || return 1
	parent=$(lsblk -ndo PKNAME "/dev/$slave" 2>/dev/null | head -n1)
	[[ -n $parent ]] || parent="$slave"
	[[ $parent == loop* ]] || return 1
	loop="/dev/$parent"
	backing=$(losetup -n -O BACK-FILE "$loop" 2>/dev/null) || return 1
	[[ $backing == "$expected_prefix"* ]] || return 1
	printf '%s\n' "$loop"
}

unmount_mapper_mounts() {
	local mapper_path="$1"
	local target
	local -a targets=()

	# Desktop automounters may remount a failed fixture below /run/media after the
	# original /mnt tree is gone. Source matching keeps cleanup inside the already
	# verified mapper instead of guessing paths.
	mapfile -t targets < <(findmnt -rn -S "$mapper_path" -o TARGET | sort -r)
	for target in "${targets[@]}"; do
		[[ -n $target ]] || continue
		echo "[CLEANUP] unmounting verified fixture target $target"
		umount "$target" || return 1
	done
}

close_fixture_mapper() {
	local mapper_name="$1"
	local mapper_path="/dev/mapper/$mapper_name"

	[[ -e $mapper_path ]] || return 0
	unmount_mapper_mounts "$mapper_path" || return 1
	cryptsetup close "$mapper_name"
}

reap_stale_fixture() {
	local stale_root_loop=""
	local stale_vm_loop=""
	local loop backing

	if [[ -e $LUKS_MAPPER ]]; then
		stale_root_loop=$(mapper_fixture_loop "$LUKS_NAME" /tmp/bootstrap-root.) \
			|| fail "refusing to close existing $LUKS_MAPPER: it is not a verified bootstrap test fixture"
	fi
	if [[ -e $VM_LUKS_MAPPER ]]; then
		stale_vm_loop=$(mapper_fixture_loop "$VM_LUKS_NAME" /tmp/bootstrap-vm.) \
			|| fail "refusing to close existing $VM_LUKS_MAPPER: it is not a verified bootstrap test fixture"
	fi

	if [[ -n $stale_root_loop || -n $stale_vm_loop ]]; then
		echo "[CLEANUP] verified stale bootstrap fixture found; removing it before the new run"
		if mountpoint -q "$MOUNT_ROOT"; then
			umount -R "$MOUNT_ROOT" \
				|| fail "could not unmount stale bootstrap fixture from $MOUNT_ROOT"
		fi
		close_fixture_mapper "$VM_LUKS_NAME" \
			|| fail "could not close stale $VM_LUKS_MAPPER"
		close_fixture_mapper "$LUKS_NAME" \
			|| fail "could not close stale $LUKS_MAPPER"
	fi

	# A previous teardown may have closed the mapper but left a loop attached to
	# a deleted sparse file. Only the gate's own /tmp names are eligible here.
	for loop in /dev/loop*; do
		[[ -b $loop ]] || continue
		backing=$(losetup -n -O BACK-FILE "$loop" 2>/dev/null) || continue
		if [[ $backing == /tmp/bootstrap-root.* || $backing == /tmp/bootstrap-vm.* ]]; then
			losetup -d "$loop" || fail "could not detach stale test loop $loop"
		fi
	done
	udevadm settle
}

reap_stale_fixture
mountpoint -q "$MOUNT_ROOT" && skip "$MOUNT_ROOT is already a non-test mountpoint — refusing"

ROOT_IMG=$(mktemp /tmp/bootstrap-root.XXXXXX)
VM_IMG=$(mktemp /tmp/bootstrap-vm.XXXXXX)
ROOT_LOOP=""
VM_LOOP=""
teardown() {
	local rc=$?
	local cleanup_failed=0
	trap - EXIT
	set +e

	if mountpoint -q "$MOUNT_ROOT"; then
		umount -R "$MOUNT_ROOT" || cleanup_failed=1
	fi
	if [[ -e $VM_LUKS_MAPPER ]]; then
		close_fixture_mapper "$VM_LUKS_NAME" || cleanup_failed=1
	fi
	if [[ -e $LUKS_MAPPER ]]; then
		close_fixture_mapper "$LUKS_NAME" || cleanup_failed=1
	fi
	if [[ -n $VM_LOOP && -b $VM_LOOP ]]; then
		losetup -d "$VM_LOOP" || cleanup_failed=1
	fi
	if [[ -n $ROOT_LOOP && -b $ROOT_LOOP ]]; then
		losetup -d "$ROOT_LOOP" || cleanup_failed=1
	fi
	rm -f "$ROOT_IMG" "$VM_IMG"
	udevadm settle 2>/dev/null || true

	if [[ -e $VM_LUKS_MAPPER || -e $LUKS_MAPPER ]]; then
		echo "[CLEANUP-FAIL] a test mapper remains active" >&2
		cleanup_failed=1
	fi
	if [[ $cleanup_failed -ne 0 ]]; then
		echo "[CLEANUP-FAIL] bootstrap fixture teardown was incomplete" >&2
		[[ $rc -ne 0 ]] || rc=1
	fi
	exit "$rc"
}
trap teardown EXIT

truncate -s 4G "$ROOT_IMG" || fail "could not create root sparse image"
truncate -s 3G "$VM_IMG" || fail "could not create VM-store sparse image"
ROOT_LOOP=$(losetup -fP --show "$ROOT_IMG") || fail "root losetup failed"
VM_LOOP=$(losetup -fP --show "$VM_IMG") || fail "VM-store losetup failed"
pass "fixtures ready: root=$ROOT_LOOP vm=$VM_LOOP"

partition_disk "$ROOT_LOOP" || fail "partition_disk failed"
[[ -e $ESP_PART && -e $ROOT_PART ]] || fail "root by-partlabel symlinks missing"
pass "GPT root layout resolvable by partlabel"

printf 'vmtestpass\nvmtestpass\n' | encrypt_root "$ROOT_PART" \
	|| fail "encrypt_root failed"
[[ -e $LUKS_MAPPER ]] || fail "$LUKS_MAPPER missing"

root_dump=$(cryptsetup luksDump "$ROOT_PART")
grep -q "Version:.*2" <<< "$root_dump" || fail "root is not LUKS2"
grep -qi "PBKDF:.*argon2id" <<< "$root_dump" || fail "root PBKDF is not argon2id"
grep -qi "cipher:.*$LUKS_CIPHER" <<< "$root_dump" || fail "root cipher mismatch"
grep -qi "$LUKS_KEY_SIZE bits" <<< "$root_dump" || fail "root key size mismatch"
pass "root LUKS2 contract confirmed"

make_filesystems || fail "make_filesystems failed"
[[ $(blkid -o value -s TYPE "$ESP_PART") == vfat ]] || fail "ESP is not vfat"
[[ $(blkid -o value -s TYPE "$LUKS_MAPPER") == btrfs ]] || fail "root mapper is not btrfs"

create_subvolumes || fail "create_subvolumes failed"
mount_layout || fail "mount_layout failed"
count=$(btrfs subvolume list "$MOUNT_ROOT" | wc -l)
(( count == ${#SUBVOL_LAYOUT[@]} )) || fail "expected ${#SUBVOL_LAYOUT[@]} subvolumes, found $count"

# Bare findmnt operands are intentionally avoided: a path can be interpreted as
# either source or target. The release gate needs the filesystem containing this
# exact directory, not util-linux's current ambiguity heuristic.
root_options=$(findmnt -rno OPTIONS --target "$MOUNT_ROOT") \
	|| fail "could not inspect root mount options"
[[ ,$root_options, == *,compress=zstd:1,* ]] \
	|| fail "root mount options lack compress=zstd:1 (observed: $root_options)"
[[ ,$root_options, == *,noatime,* ]] \
	|| fail "root mount options lack noatime (observed: $root_options)"
vm_target="$MOUNT_ROOT$(vm_storage_mountpoint)"
lsattr -d "$vm_target" | awk '{print $1}' | grep -q C \
	|| fail "root-side @vm lacks +C"
! grep -Eq 'mount -o .*nodatacow|btrfs rw,[^[:space:]]*nodatacow' "$HERE/installer" \
	|| fail "installer still advertises a misleading nodatacow mount option"
[[ $(findmnt -rno FSTYPE --target "$MOUNT_ROOT/boot") == vfat ]] \
	|| fail "ESP not mounted at /boot"
[[ $(detect_vm_storage_topology) == single-disk ]] \
	|| fail "single-disk topology was not detected as cryptroot:/@vm"
pass "single-disk fallback is mounted and NOCOW inheritance is present"

mkdir -p "$MOUNT_ROOT/etc"
printf '%s %s btrfs rw,noatime,compress=zstd:1,subvol=/@vm 0 0\n' \
	"$LUKS_MAPPER" "$(vm_storage_mountpoint)" > "$MOUNT_ROOT/etc/fstab"
: > "$MOUNT_ROOT/etc/crypttab"

encrypt_vm_disk "$VM_LOOP" || fail "encrypt_vm_disk failed"
[[ -e $VM_PART && -e $VM_LUKS_MAPPER ]] || fail "dedicated VM mapper or partition missing"
[[ $(cryptsetup luksDump "$VM_PART" | grep -c 'Version:.*2') -eq 1 ]] \
	|| fail "VM disk is not LUKS2"

topology=$(detect_vm_storage_topology) || fail "dedicated topology detection failed"
[[ $topology == dedicated-disk ]] || fail "cryptvm:/ was not detected as dedicated-disk"
finalize_vm_storage_key "$topology" || fail "VM keyfile finalization failed"
[[ $(stat -c %a "$MOUNT_ROOT$VM_KEYFILE") == 400 ]] \
	|| fail "VM keyfile is not mode 0400"

vm_uuid=$(cryptsetup luksUUID "$VM_PART")
grep -qx "$VM_LUKS_NAME UUID=$vm_uuid $VM_KEYFILE luks" "$MOUNT_ROOT/etc/crypttab" \
	|| fail "crypttab does not bind cryptvm to its UUID/keyfile"
grep -qx "$VM_LUKS_MAPPER $(vm_storage_mountpoint) btrfs rw,noatime 0 0" "$MOUNT_ROOT/etc/fstab" \
	|| fail "fstab did not adopt the dedicated mapper"
! grep -q "$LUKS_MAPPER.*$(vm_storage_mountpoint)" "$MOUNT_ROOT/etc/fstab" \
	|| fail "root-side @vm fstab entry survived adoption"
[[ $(findmnt -rno SOURCE --target "$vm_target") == "$VM_LUKS_MAPPER" ]] \
	|| fail "VM mountpoint is not backed by cryptvm"
[[ $(findmnt -rno FSROOT --target "$vm_target") == / ]] \
	|| fail "dedicated VM store is not mounted from filesystem root"
[[ $(findmnt -rno FSTYPE --target "$vm_target") == btrfs ]] \
	|| fail "dedicated VM store is not Btrfs"
lsattr -d "$vm_target" | awk '{print $1}' | grep -q C \
	|| fail "dedicated VM store lacks +C"
pass "dedicated encrypted VM disk adopted at the libvirt image mountpoint"

verify_vm_storage "$topology" || fail "post-install VM storage verification failed"
write_storage_contract "$topology" || fail "storage contract write failed"
contract="$MOUNT_ROOT$BOOTSTRAP_STORAGE_CONTRACT"
[[ -f $contract && $(stat -c %a "$contract") == 644 ]] \
	|| fail "bootstrap storage contract missing or incorrectly protected"
grep -q '^  topology: dedicated-disk$' "$contract" || fail "contract topology mismatch"
grep -q '^  mountpoint: /var/lib/libvirt/images$' "$contract" || fail "contract mountpoint mismatch"
grep -q '^  mapper: /dev/mapper/cryptvm$' "$contract" || fail "contract mapper mismatch"
grep -q '^  subvolume: null$' "$contract" || fail "contract subvolume mismatch"
grep -q '^  require_nocow: true$' "$contract" || fail "contract NOCOW policy missing"
pass "stage-2 storage contract binds Hyperlab to the dedicated VM disk"

echo
echo "ALL TWO-DISK BOOTSTRAP PIPELINE TESTS PASSED (teardown runs automatically)"
